{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "verdi-solarr",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    // Static files (HTML, JS, CSS, PDFs, images) are served by Cloudflare's asset
    // layer WITHOUT invoking the Worker (free + unlimited). Only /api/* runs the Worker.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    // Catalogue pages (home, all products, categories, products, local pages), sitemap and robots also go
    // through the Worker: titles, preview tags, JSON-LD and crawler text come from the LIVE catalogue.
    "run_worker_first": ["/api/*","/","/products","/products/*","/category/*","/faq","/solar-panels-chennai","/solar-inverters-chennai","/solar-cables-chennai","/solar-products-tamil-nadu","/sitemap.xml","/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "verdi-db",
      // Replace with the id printed by `npx wrangler d1 create verdi-db` (see CLOUDFLARE_SETUP.md)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    // Admin uploads (product images, datasheets, field photos, brand logos). Create with `npx wrangler r2 bucket create verdi-media`.
    { "binding": "MEDIA", "bucket_name": "verdi-media" }
  ],
  "ratelimits": [
    { "name": "PUBLIC_LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    { "name": "ADMIN_LIMITER", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    // Customer sign-in / registration / enquiry writes (per IP)
    { "name": "AUTH_LIMITER", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    // Comma-separated hostnames allowed to perform admin writes (CSRF/origin check), e.g. "verdisolarr.com,www.verdisolarr.com"
    "ADMIN_ALLOWED_HOSTS": "",
    "PUBLIC_CACHE_SECONDS": "60"
  },
  // Secrets (NOT here, never in GitHub): PASSWORD_PEPPER — set with `npx wrangler secret put PASSWORD_PEPPER`. See PASSWORDS.md.

  // TEST site on a free workers.dev address with dummy data (its own database, no R2 file storage, never
  // indexed by search engines). Completely separate from production: delete it any time.
  //   build + deploy:  npm run deploy:test        migrations:  npm run db:migrate:test
  "env": {
    "test": {
      "name": "verdi-solarr-test",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "verdi-db-test",
          "database_id": "3947cce3-9014-4a0f-991f-09f484148694",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "PUBLIC_LIMITER", "namespace_id": "4201", "simple": { "limit": 60, "period": 60 } },
        { "name": "ADMIN_LIMITER", "namespace_id": "4202", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_LIMITER", "namespace_id": "4203", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": { "ENVIRONMENT": "test", "ADMIN_ALLOWED_HOSTS": "", "PUBLIC_CACHE_SECONDS": "60" }
    }
  }
}
